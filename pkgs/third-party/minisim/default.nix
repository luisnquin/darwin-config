{
  actool,
  darwin,
  fetchFromGitHub,
  lib,
  librsvg,
  perl,
  swift,
  swiftPackages,
  swiftpm,
  swiftpm2nix,
}: let
  # Generated by running `swiftpm2nix` after `swift package resolve` with the
  # Package.swift next to this file.
  generated = swiftpm2nix.helpers ./nix;

  toPlist = lib.generators.toPlist {escape = true;};

  # Xcode assembles this from the project's INFOPLIST_KEY_* settings; SwiftPM
  # only builds the executable, so the bundle metadata is spelled out here.
  infoPlist = version:
    toPlist {
      CFBundleDevelopmentRegion = "en";
      CFBundleDisplayName = "MiniSim";
      CFBundleExecutable = "MiniSim";
      CFBundleIconFile = "AppIcon";
      CFBundleIconName = "AppIcon";
      CFBundleIdentifier = "com.oskarkwasniewski.MiniSim";
      CFBundleInfoDictionaryVersion = "6.0";
      CFBundleName = "MiniSim";
      CFBundlePackageType = "APPL";
      CFBundleShortVersionString = version;
      CFBundleVersion = "19";
      LSApplicationCategoryType = "public.app-category.developer-tools";
      LSMinimumSystemVersion = "13.0";
      LSUIElement = true;
      NSAppleScriptEnabled = true;
      NSHumanReadableCopyright = "";
      NSPrincipalClass = "NSApplication";
      NSRemovableVolumesUsageDescription = "MiniSim launches Android tools stored on a removable volume.";
      OSAScriptingDefinition = "MiniSim.sdef";
    };
in
  swiftPackages.stdenv.mkDerivation (finalAttrs: {
    pname = "minisim";
    version = "0.10.0";

    src = fetchFromGitHub {
      owner = "okwasniewski";
      repo = "MiniSim";
      tag = "v${finalAttrs.version}";
      hash = "sha256-WaIg+ND1wF87N50a4Cgy1Cj/r79HtMCvbiKKLIvBt6A=";
    };

    # Sparkle and LaunchAtLogin ship prebuilt binaries, which a source build
    # cannot use. Updates come through nix and launch-at-login through launchd.
    patches = [
      ./patches/no-sparkle.patch
      ./patches/no-launch-at-login.patch
    ];

    postPatch = ''
      cp ${./Package.swift} Package.swift
      rsvg-convert -w 22 -h 38 ${./menubar-iphone.svg} \
        -o MiniSim/Assets.xcassets/iphone.imageset/iphone@2x.png
    '';

    nativeBuildInputs = [
      actool
      darwin.autoSignDarwinBinariesHook
      librsvg
      perl
      swift
      swiftpm
    ];

    configurePhase =
      generated.configure
      # `#Preview` expands through Xcode's SwiftUI macro plugin, which the
      # nixpkgs toolchain does not ship. The blocks only feed Xcode's canvas.
      + ''
        for dep in KeyboardShortcuts SymbolPicker; do
          swiftpmMakeMutable "$dep"
        done
        perl -0pi -e 's/^#Preview\b[^\n]*\{\n(?:.*\n)*?\}\n//mg' \
          .build/checkouts/KeyboardShortcuts/Sources/KeyboardShortcuts/Recorder.swift \
          .build/checkouts/SymbolPicker/Sources/SymbolPicker/SymbolPicker.swift
      '';

    installPhase = ''
      runHook preInstall

      app="$out/Applications/MiniSim.app"
      bin="$(swiftpmBinPath)"
      mkdir -p "$app/Contents/"{MacOS,Resources}

      cp "$bin/MiniSim" "$app/Contents/MacOS/MiniSim"
      printf '%s' ${lib.escapeShellArg (infoPlist finalAttrs.version)} > "$app/Contents/Info.plist"
      printf 'APPL????' > "$app/Contents/PkgInfo"

      # SwiftPM 5.10's Bundle.module accessor looks for dependency resource
      # bundles next to Bundle.main.bundleURL, i.e. at the .app root.
      cp -R "$bin"/*.bundle "$app/"

      cp "MiniSim/AppleScript Commands/MiniSim.sdef" "$app/Contents/Resources/"
      # AcknowList lists licences from the app's Package.resolved.
      cp -L Package.resolved "$app/Contents/Resources/"

      actool --compile "$app/Contents/Resources" \
        --platform macosx \
        --minimum-deployment-target 13.0 \
        --app-icon AppIcon \
        --output-partial-info-plist /dev/null \
        MiniSim/Assets.xcassets

      runHook postInstall
    '';

    meta = {
      description = "Menu bar utility to launch iOS simulators and Android emulators";
      homepage = "https://github.com/okwasniewski/MiniSim";
      license = lib.licenses.mit;
      platforms = ["aarch64-darwin" "x86_64-darwin"];
    };
  })
