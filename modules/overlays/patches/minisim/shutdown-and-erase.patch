+
+  func erase() throws {
+    try simulatorService().eraseDevice()
+  }
+
+  // Powering a device off and wiping it are simctl-only, so they stay off
+  // DeviceServiceCommon rather than forcing an unsupported android branch.
+  private func simulatorService() throws -> IOSDeviceService {
+    guard let service = deviceService as? IOSDeviceService else {
+      throw UnsupportedActionError(
+        message: NSLocalizedString("This action is only available for iOS simulators.", comment: "")
+      )
+    }
+    return service
+  }
 }
 
