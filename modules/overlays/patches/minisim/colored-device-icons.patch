diff --git a/MiniSim/Model/DeviceFamily.swift b/MiniSim/Model/DeviceFamily.swift
index 8f4fd2b..00ba396 100644
--- a/MiniSim/Model/DeviceFamily.swift
+++ b/MiniSim/Model/DeviceFamily.swift
@@ -5,6 +5,7 @@
 //  Created by Oskar Kwaśniewski on 17/01/2026.
 //
 
+import AppKit
 import Foundation
 
 enum DeviceFamily: String, Codable {
@@ -33,6 +34,27 @@ enum DeviceFamily: String, Codable {
     }
   }
 
+  /// Rendering colour for the row icon. Symbols are drawn tinted rather than as
+  /// templates so a family is recognisable before the label is read; the palette
+  /// follows Apple's own per-product accent so it stays legible on the menu's
+  /// translucent material in both appearances.
+  var tint: NSColor {
+    switch self {
+    case .iPhone:
+      return .systemBlue
+    case .iPad:
+      return .systemPurple
+    case .watch:
+      return .systemRed
+    case .tv:
+      return .systemIndigo
+    case .vision:
+      return .systemTeal
+    case .unknown:
+      return .systemGray
+    }
+  }
+
   /// Parses `deviceTypeIdentifier` from simctl JSON output.
   /// Example: `com.apple.CoreSimulator.SimDeviceType.iPhone-14-Pro`
   init(fromDeviceTypeIdentifier identifier: String) {
@@ -50,4 +72,20 @@ enum DeviceFamily: String, Codable {
       self = .unknown
     }
   }
+
+  /// Physical iOS devices and every Android device reach the menu without a
+  /// family, so the marketing name is the only signal left to classify them.
+  init(fromDisplayName name: String) {
+    if name.contains("Apple TV") || name.contains("TV") {
+      self = .tv
+    } else if name.contains("iPad") || name.contains("Tablet") {
+      self = .iPad
+    } else if name.contains("Apple Watch") {
+      self = .watch
+    } else if name.contains("Vision") {
+      self = .vision
+    } else {
+      self = .iPhone
+    }
+  }
 }
