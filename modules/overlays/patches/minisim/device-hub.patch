+        try shell.execute(command: "/usr/bin/open", arguments: ["odhub://open?udid=\(uuid)"])
+      } else {
+        try shell.execute(command: "/usr/bin/open", arguments: ["-b", "com.apple.dt.Devices"])
+      }
+      return
+    }
