diff --git a/MiniSim/Service/DeviceServiceFactory.swift b/MiniSim/Service/DeviceServiceFactory.swift
index c656dcb..84b8d92 100644
--- a/MiniSim/Service/DeviceServiceFactory.swift
+++ b/MiniSim/Service/DeviceServiceFactory.swift
@@ -25,6 +25,43 @@ class DeviceServiceFactory {
     }
   }
 
+  // A full getAllDevices is too slow to poll: the Android emulator parser
+  // shells out per AVD and devicectl blocks for seconds on physical iPhones.
+  // The status item count only needs booted virtual devices, which two cheap
+  // commands answer: simctl's JSON state and adb's emulator-* serials.
+  static func getBootedVirtualDeviceCount(
+    android: Bool,
+    iOS: Bool,
+    completionQueue: DispatchQueue = .main,
+    completion: @escaping (Int) -> Void
+  ) {
+    queue.async {
+      var count = 0
+
+      if iOS, let output = try? Shell().execute(
+        command: DeviceConstants.ProcessPaths.xcrun.rawValue,
+        arguments: ["simctl", "list", "devices", "available", "-j"]
+      ) {
+        count += DeviceParserFactory().getParser(.iosSimulator)
+          .parse(output)
+          .filter { $0.booted }
+          .count
+      }
+
+      if android,
+         let adbPath = try? ADB.getAdbPath(),
+         let output = try? Shell().execute(command: adbPath, arguments: ["devices"]) {
+        count += output.components(separatedBy: .newlines)
+          .filter { $0.hasPrefix("emulator-") && $0.contains("device") }
+          .count
+      }
+
+      completionQueue.async {
+        completion(count)
+      }
+    }
+  }
